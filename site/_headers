# Cloudflare Pages: keep the *.pages.dev copies out of search results, so only
# waitlight.cassianflorin.com is indexed (the pages also carry a canonical link).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Link headers (RFC 8288) let agents find the plain-text summary, the sitemap,
# the other language and the Markdown version without parsing the page.
# functions/_middleware.js sets the same header in case these rules don't
# reach its responses.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml", </en/>; rel="alternate"; hreflang="en", </index.md>; rel="alternate"; type="text/markdown"

/en/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml", </>; rel="alternate"; hreflang="zh-Hans", </en/index.md>; rel="alternate"; type="text/markdown"
