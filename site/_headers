# Cloudflare Pages: keep the *.pages.dev copies out of search results, so only
# agentdeck.cassianflorin.com is indexed (the pages also carry a canonical link).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Link headers (RFC 8288) let agents find the plain-text summary, the sitemap
# and the other language without parsing the page.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml", </en/>; rel="alternate"; hreflang="en"

/en/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml", </>; rel="alternate"; hreflang="zh-Hans"
